# Copy this file to .env (or export these as real environment variables /
# IntelliJ-VSCode run config env vars) and fill in your own Supabase
# project's values. NEVER commit the real .env file.

# Dashboard -> "Connect" button -> JDBC tab -> Session pooler, e.g.:
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# (Not the "Direct connection" string - that requires IPv6, which most
# local dev setups don't have.)
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres

# With the Session pooler, the username is postgres.<project-ref>, not
# just "postgres". Find it in the same Connect -> JDBC panel.
SUPABASE_DB_USERNAME=postgres.<project-ref>

# The database password you set when creating the Supabase project
SUPABASE_DB_PASSWORD=your-password-here

# Origin of the React dev server (Vite's default)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Lab 3: LegacySupply (never commit real values) ---
LS_CLIENT_ID=your-student-id
LS_API_KEY=LSK-your-key-from-instructor
